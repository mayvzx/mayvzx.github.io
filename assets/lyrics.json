{"duration":192.744,"lines":[{"text":"Mariazinha…","section":"Intro","words":[{"text":"Mariazinha…","start":9.02,"end":9.56}],"start":9.02,"end":9.56},{"text":"Essa é pra quando tu acordar.","section":"Intro","words":[{"text":"Essa","start":9.56,"end":10.1},{"text":"é","start":10.1,"end":10.26},{"text":"pra","start":10.26,"end":10.34},{"text":"quando","start":10.34,"end":10.62},{"text":"tu","start":10.62,"end":10.8},{"text":"acordar.","start":10.8,"end":11.4}],"start":9.56,"end":11.4},{"text":"Mariazinha, dou play no teu áudio","section":"Verse 1","words":[{"text":"Mariazinha,","start":12.84,"end":13.38},{"text":"dou","start":13.38,"end":13.56},{"text":"play","start":13.56,"end":13.78},{"text":"no","start":13.78,"end":13.92},{"text":"teu","start":13.92,"end":14.24},{"text":"áudio","start":14.24,"end":14.76}],"start":12.84,"end":14.76},{"text":"Só pra ouvir de novo teu jeito de falar","section":"Verse 1","words":[{"text":"Só","start":14.82,"end":15.12},{"text":"pra","start":15.12,"end":15.4},{"text":"ouvir","start":15.4,"end":15.64},{"text":"de","start":15.64,"end":15.74},{"text":"novo","start":15.74,"end":16.0},{"text":"teu","start":16.14,"end":16.24},{"text":"jeito","start":16.24,"end":16.64},{"text":"de","start":16.64,"end":16.92},{"text":"falar","start":16.92,"end":17.4}],"start":14.82,"end":17.4},{"text":"A distância deixa a noite comprida","section":"Verse 1","words":[{"text":"A","start":17.86,"end":18.16},{"text":"distância","start":18.16,"end":18.58},{"text":"deixa","start":18.58,"end":18.9},{"text":"a","start":18.9,"end":19.06},{"text":"noite","start":19.06,"end":19.22},{"text":"comprida","start":19.22,"end":19.96}],"start":17.86,"end":19.96},{"text":"E eu invento assunto pra tu não desligar","section":"Verse 1","words":[{"text":"E","start":19.96,"end":20.22},{"text":"eu","start":20.22,"end":20.38},{"text":"invento","start":20.38,"end":20.8},{"text":"assunto","start":20.8,"end":21.12},{"text":"pra","start":21.12,"end":21.56},{"text":"tu","start":21.56,"end":21.82},{"text":"não","start":21.82,"end":22.02},{"text":"desligar","start":22.02,"end":22.66}],"start":19.96,"end":22.66},{"text":"Tu fala na lata, não faz personagem","section":"Verse 1","words":[{"text":"Tu","start":22.72,"end":22.92},{"text":"fala","start":22.92,"end":23.26},{"text":"na","start":23.26,"end":23.52},{"text":"lata,","start":23.52,"end":23.84},{"text":"não","start":24.12,"end":24.24},{"text":"faz","start":24.24,"end":24.52},{"text":"personagem","start":24.52,"end":25.16}],"start":22.72,"end":25.16},{"text":"Tem teu próprio jeito, não pede licença","section":"Verse 1","words":[{"text":"Tem","start":25.56,"end":25.7},{"text":"teu","start":25.7,"end":25.88},{"text":"próprio","start":25.88,"end":26.16},{"text":"jeito,","start":26.16,"end":26.44},{"text":"não","start":26.58,"end":26.72},{"text":"pede","start":26.72,"end":26.96},{"text":"licença","start":26.96,"end":27.8}],"start":25.56,"end":27.8},{"text":"E esse teu dengo, que pouca gente conhece","section":"Verse 1","words":[{"text":"E","start":27.82,"end":28.1},{"text":"esse","start":28.1,"end":28.34},{"text":"teu","start":28.34,"end":28.58},{"text":"dengo,","start":28.58,"end":28.88},{"text":"que","start":28.88,"end":29.02},{"text":"pouca","start":29.02,"end":29.4},{"text":"gente","start":29.4,"end":29.62},{"text":"conhece","start":29.64,"end":30.42}],"start":27.82,"end":30.42},{"text":"Me desmonta todo, até sem tua presença","section":"Verse 1","words":[{"text":"Me","start":30.58,"end":30.78},{"text":"desmonta","start":30.78,"end":31.26},{"text":"todo,","start":31.28,"end":31.52},{"text":"até","start":31.52,"end":31.8},{"text":"sem","start":31.8,"end":32.14},{"text":"tua","start":32.14,"end":32.32},{"text":"presença","start":32.32,"end":33.2}],"start":30.58,"end":33.2},{"text":"Tu é bonita de me fazer perder a fala","section":"Verse 1","words":[{"text":"Tu","start":33.2,"end":33.6},{"text":"é","start":33.6,"end":33.68},{"text":"bonita","start":33.68,"end":34.08},{"text":"de","start":34.08,"end":34.3},{"text":"me","start":34.3,"end":34.44},{"text":"fazer","start":34.44,"end":34.74},{"text":"perder","start":34.74,"end":35.12},{"text":"a","start":35.12,"end":35.38},{"text":"fala","start":35.38,"end":35.84}],"start":33.2,"end":35.84},{"text":"E esse teu jeito me faz perder a hora","section":"Verse 1","words":[{"text":"E","start":35.84,"end":36.1},{"text":"esse","start":36.1,"end":36.34},{"text":"teu","start":36.34,"end":36.52},{"text":"jeito","start":36.52,"end":36.86},{"text":"me","start":36.86,"end":37.14},{"text":"faz","start":37.14,"end":37.4},{"text":"perder","start":37.4,"end":37.8},{"text":"a","start":37.8,"end":38.16},{"text":"hora","start":38.16,"end":38.46}],"start":35.84,"end":38.46},{"text":"Eu vou ficando só pra ouvir tua risada","section":"Verse 1","words":[{"text":"Eu","start":38.46,"end":38.72},{"text":"vou","start":38.72,"end":38.86},{"text":"ficando","start":38.86,"end":39.26},{"text":"só","start":39.26,"end":39.64},{"text":"pra","start":39.64,"end":39.84},{"text":"ouvir","start":39.84,"end":40.14},{"text":"tua","start":40.14,"end":40.34},{"text":"risada","start":40.34,"end":41.0}],"start":38.46,"end":41.0},{"text":"Até o sono desistir e ir embora","section":"Verse 1","words":[{"text":"Até","start":41.0,"end":41.5},{"text":"o","start":41.5,"end":41.72},{"text":"sono","start":41.72,"end":41.98},{"text":"desistir","start":41.98,"end":42.84},{"text":"e","start":42.9,"end":42.92},{"text":"ir","start":42.92,"end":43.18},{"text":"embora","start":43.18,"end":43.56}],"start":41.0,"end":43.56},{"text":"Se tu pensa que eu vou querer outra","section":"Pre-Chorus","words":[{"text":"Se","start":43.56,"end":44.42},{"text":"tu","start":44.42,"end":44.58},{"text":"pensa","start":44.58,"end":44.92},{"text":"que","start":44.92,"end":45.22},{"text":"eu","start":45.22,"end":45.34},{"text":"vou","start":45.34,"end":45.5},{"text":"querer","start":45.5,"end":45.94},{"text":"outra","start":45.94,"end":46.58}],"start":43.56,"end":46.58},{"text":"Eu tô pensando numa data pra te ver","section":"Pre-Chorus","words":[{"text":"Eu","start":46.58,"end":46.98},{"text":"tô","start":46.98,"end":47.08},{"text":"pensando","start":47.08,"end":47.54},{"text":"numa","start":47.54,"end":48.08},{"text":"data","start":48.08,"end":48.38},{"text":"pra","start":48.38,"end":48.62},{"text":"te","start":48.62,"end":48.88},{"text":"ver","start":48.88,"end":49.26}],"start":46.58,"end":49.26},{"text":"Quero teu bom-dia perto do ouvido","section":"Pre-Chorus","words":[{"text":"Quero","start":49.26,"end":49.74},{"text":"teu","start":49.74,"end":49.98},{"text":"bom-dia","start":49.98,"end":50.54},{"text":"perto","start":50.54,"end":51.02},{"text":"do","start":51.02,"end":51.3},{"text":"ouvido","start":51.3,"end":51.9}],"start":49.26,"end":51.9},{"text":"Sem uma tela entre mim e você","section":"Pre-Chorus","words":[{"text":"Sem","start":51.9,"end":52.24},{"text":"uma","start":52.24,"end":52.58},{"text":"tela","start":52.58,"end":53.02},{"text":"entre","start":53.02,"end":53.36},{"text":"mim","start":53.36,"end":53.66},{"text":"e","start":53.66,"end":53.92},{"text":"você","start":53.92,"end":54.38}],"start":51.9,"end":54.38},{"text":"Maria, eu tô pensando em casar","section":"Chorus","words":[{"text":"Maria,","start":54.38,"end":55.48},{"text":"eu","start":55.96,"end":56.18},{"text":"tô","start":56.18,"end":56.44},{"text":"pensando","start":56.44,"end":57.22},{"text":"em","start":57.22,"end":57.52},{"text":"casar","start":57.52,"end":58.58}],"start":54.38,"end":58.58},{"text":"Tu com medo de eu ir, eu querendo ficar","section":"Chorus","words":[{"text":"Tu","start":58.58,"end":59.28},{"text":"com","start":59.28,"end":59.64},{"text":"medo","start":59.64,"end":60.0},{"text":"de","start":60.0,"end":60.42},{"text":"eu","start":60.42,"end":60.72},{"text":"ir,","start":60.72,"end":61.16},{"text":"eu","start":61.44,"end":61.56},{"text":"querendo","start":61.56,"end":62.74},{"text":"ficar","start":62.74,"end":63.6}],"start":58.58,"end":63.6},{"text":"Hoje, tua voz do outro lado da linha","section":"Chorus","words":[{"text":"Hoje,","start":64.38,"end":64.94},{"text":"tua","start":65.4,"end":65.88},{"text":"voz","start":65.88,"end":66.54},{"text":"do","start":66.54,"end":66.82},{"text":"outro","start":66.82,"end":67.2},{"text":"lado","start":67.2,"end":67.98},{"text":"da","start":67.98,"end":68.6},{"text":"linha","start":68.6,"end":69.34}],"start":64.38,"end":69.34},{"text":"Eu quero acordar com minha Mariazinha","section":"Chorus","words":[{"text":"Eu","start":69.34,"end":70.24},{"text":"quero","start":70.24,"end":70.62},{"text":"acordar","start":70.62,"end":71.78},{"text":"com","start":71.78,"end":72.2},{"text":"minha","start":72.2,"end":72.8},{"text":"Mariazinha","start":72.8,"end":74.76}],"start":69.34,"end":74.76},{"text":"Tu me conta um plano, eu já faço torcida","section":"Verse 2","words":[{"text":"Tu","start":75.58,"end":76.38},{"text":"me","start":76.38,"end":76.6},{"text":"conta","start":76.6,"end":76.76},{"text":"um","start":76.76,"end":77.06},{"text":"plano,","start":77.06,"end":77.36},{"text":"eu","start":77.52,"end":77.535},{"text":"já","start":77.52,"end":77.6},{"text":"faço","start":77.6,"end":77.92},{"text":"torcida","start":77.92,"end":78.5}],"start":75.58,"end":78.5},{"text":"Imagino tua cara quando realizar","section":"Verse 2","words":[{"text":"Imagino","start":78.5,"end":79.22},{"text":"tua","start":79.22,"end":79.52},{"text":"cara","start":79.52,"end":79.92},{"text":"quando","start":79.92,"end":80.22},{"text":"realizar","start":80.22,"end":81.06}],"start":78.5,"end":81.06},{"text":"Quando tu fala dos teus guias, eu escuto","section":"Verse 2","words":[{"text":"Quando","start":81.06,"end":81.52},{"text":"tu","start":81.52,"end":81.8},{"text":"fala","start":81.8,"end":82.06},{"text":"dos","start":82.06,"end":82.34},{"text":"teus","start":82.34,"end":82.62},{"text":"guias,","start":82.62,"end":83.02},{"text":"eu","start":83.12,"end":83.3},{"text":"escuto","start":83.3,"end":83.7}],"start":81.06,"end":83.7},{"text":"É mais um jeito de aprender a te amar","section":"Verse 2","words":[{"text":"É","start":83.98,"end":84.2},{"text":"mais","start":84.2,"end":84.44},{"text":"um","start":84.44,"end":84.56},{"text":"jeito","start":84.56,"end":84.76},{"text":"de","start":84.76,"end":85.0},{"text":"aprender","start":85.0,"end":85.38},{"text":"a","start":85.38,"end":85.86},{"text":"te","start":85.86,"end":86.06},{"text":"amar","start":86.06,"end":86.42}],"start":83.98,"end":86.42},{"text":"Tem coisa minha que eu venho adiando","section":"Verse 2","words":[{"text":"Tem","start":86.42,"end":86.86},{"text":"coisa","start":86.86,"end":87.14},{"text":"minha","start":87.14,"end":87.48},{"text":"que","start":87.48,"end":87.68},{"text":"eu","start":87.68,"end":87.8},{"text":"venho","start":87.8,"end":88.16},{"text":"adiando","start":88.16,"end":89.04}],"start":86.42,"end":89.04},{"text":"E já passou da hora de começar","section":"Verse 2","words":[{"text":"E","start":89.04,"end":89.58},{"text":"já","start":89.58,"end":89.76},{"text":"passou","start":89.76,"end":90.14},{"text":"da","start":90.14,"end":90.34},{"text":"hora","start":90.34,"end":90.54},{"text":"de","start":90.54,"end":90.74},{"text":"começar","start":90.74,"end":91.58}],"start":89.04,"end":91.58},{"text":"Quero chegar com meus planos andando","section":"Verse 2","words":[{"text":"Quero","start":91.58,"end":92.38},{"text":"chegar","start":92.38,"end":92.68},{"text":"com","start":92.68,"end":92.98},{"text":"meus","start":92.98,"end":93.12},{"text":"planos","start":93.12,"end":93.7},{"text":"andando","start":93.7,"end":94.4}],"start":91.58,"end":94.4},{"text":"E ter mais que promessa pra te dar","section":"Verse 2","words":[{"text":"E","start":94.4,"end":94.98},{"text":"ter","start":94.98,"end":95.12},{"text":"mais","start":95.14,"end":95.48},{"text":"que","start":95.48,"end":95.64},{"text":"promessa","start":95.64,"end":96.26},{"text":"pra","start":96.26,"end":96.5},{"text":"te","start":96.5,"end":96.84},{"text":"dar","start":96.84,"end":97.18}],"start":94.4,"end":97.18},{"text":"Se eu te faço rir, já valeu meu dia","section":"Verse 2","words":[{"text":"Se","start":97.18,"end":97.56},{"text":"eu","start":97.56,"end":97.66},{"text":"te","start":97.66,"end":97.86},{"text":"faço","start":97.86,"end":98.46},{"text":"rir,","start":98.46,"end":99.0},{"text":"já","start":99.1,"end":99.22},{"text":"valeu","start":99.22,"end":99.58},{"text":"meu","start":99.58,"end":99.7},{"text":"dia","start":99.7,"end":100.02}],"start":97.18,"end":100.02},{"text":"Fico sorrindo pro celular também","section":"Verse 2","words":[{"text":"Fico","start":100.42,"end":100.78},{"text":"sorrindo","start":100.78,"end":101.34},{"text":"pro","start":101.34,"end":101.7},{"text":"celular","start":101.7,"end":102.18},{"text":"também","start":102.18,"end":102.86}],"start":100.42,"end":102.86},{"text":"Às vezes termino a conversa contigo","section":"Verse 2","words":[{"text":"Às","start":102.86,"end":103.34},{"text":"vezes","start":103.34,"end":103.5},{"text":"termino","start":103.5,"end":104.28},{"text":"a","start":104.28,"end":104.44},{"text":"conversa","start":104.44,"end":105.04},{"text":"contigo","start":105.04,"end":105.68}],"start":102.86,"end":105.68},{"text":"E fico pensando em você além","section":"Verse 2","words":[{"text":"E","start":105.68,"end":105.88},{"text":"fico","start":105.88,"end":106.28},{"text":"pensando","start":106.28,"end":107.0},{"text":"em","start":107.0,"end":107.3},{"text":"você","start":107.3,"end":107.72},{"text":"além","start":107.72,"end":108.34}],"start":105.68,"end":108.34},{"text":"Maria, eu tô pensando em casar","section":"Chorus","words":[{"text":"Maria,","start":108.34,"end":109.38},{"text":"eu","start":109.56,"end":110.22},{"text":"tô","start":110.22,"end":110.34},{"text":"pensando","start":110.34,"end":111.14},{"text":"em","start":111.14,"end":111.46},{"text":"casar","start":111.46,"end":112.32}],"start":108.34,"end":112.32},{"text":"Tu com medo de eu ir, eu querendo ficar","section":"Chorus","words":[{"text":"Tu","start":112.74,"end":113.2},{"text":"com","start":113.22,"end":113.54},{"text":"medo","start":113.54,"end":113.9},{"text":"de","start":113.9,"end":114.36},{"text":"eu","start":114.36,"end":114.68},{"text":"ir,","start":114.68,"end":115.26},{"text":"eu","start":115.34,"end":115.48},{"text":"querendo","start":115.48,"end":116.66},{"text":"ficar","start":116.66,"end":117.52}],"start":112.74,"end":117.52},{"text":"Hoje, tua voz do outro lado da linha","section":"Chorus","words":[{"text":"Hoje,","start":118.32,"end":118.9},{"text":"tua","start":119.46,"end":119.84},{"text":"voz","start":119.84,"end":120.38},{"text":"do","start":120.38,"end":120.8},{"text":"outro","start":120.8,"end":121.14},{"text":"lado","start":121.14,"end":121.9},{"text":"da","start":121.9,"end":122.54},{"text":"linha","start":122.54,"end":123.26}],"start":118.32,"end":123.26},{"text":"Eu quero acordar com minha Mariazinha","section":"Chorus","words":[{"text":"Eu","start":123.26,"end":124.18},{"text":"quero","start":124.18,"end":124.58},{"text":"acordar","start":124.58,"end":125.7},{"text":"com","start":125.7,"end":126.18},{"text":"minha","start":126.18,"end":126.76},{"text":"Mariazinha","start":126.76,"end":128.7}],"start":123.26,"end":128.7},{"text":"Quero te puxar pra dançar na cozinha","section":"Bridge","words":[{"text":"Quero","start":129.32,"end":129.98},{"text":"te","start":129.98,"end":130.2},{"text":"puxar","start":130.2,"end":130.56},{"text":"pra","start":130.56,"end":130.7},{"text":"dançar","start":130.7,"end":131.2},{"text":"na","start":131.2,"end":131.56},{"text":"cozinha","start":131.56,"end":132.18}],"start":129.32,"end":132.18},{"text":"Sem olhar a hora de me despedir","section":"Bridge","words":[{"text":"Sem","start":132.18,"end":132.6},{"text":"olhar","start":132.6,"end":132.86},{"text":"a","start":132.86,"end":133.1},{"text":"hora","start":133.1,"end":133.34},{"text":"de","start":133.34,"end":133.58},{"text":"me","start":133.58,"end":133.76},{"text":"despedir